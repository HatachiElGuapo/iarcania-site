# Postgres (Drizzle). Valor canónico en .env.local con el host de la red
# Docker ("postgres"). Para `npm run dev` en el host, poné SOLO la línea
# DATABASE_URL con host "localhost" en .env.development.local (git-ignorado):
# Next lo carga con más prioridad que .env.local únicamente en desarrollo, y
# el contenedor lo ignora. Así no hay que editar .env.local a mano.
DATABASE_URL=postgres://user:password@host:5432/database

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Anthropic — usado por app/api/generar-copy, generar-presentacion, generate-script, scan-receipt
ANTHROPIC_API_KEY=
